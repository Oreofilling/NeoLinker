platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
    end
  end

  # Source-patch flutter_inappwebview_macos 1.2.0-beta.3 (latest flavor):
  # the published pod conforms the 10.14-available WebAuthenticationSession
  # class to ASWebAuthenticationPresentationContextProviding (10.15+),
  # which cannot compile at the podspec's osx 10.14 minimum. This ports
  # the upstream fix (flutter_inappwebview PR #2809): the conformance
  # moves into a separate @available(macOS 10.15, *) helper class.
  # Flutter integrates plugins as :path pods into PUB_CACHE, and the
  # patch precedes xcodebuild in the same invocation. Drop once a
  # release carries PR #2809.
  target_file = Dir[File.join(ENV['PUB_CACHE'] || File.join(Dir.home, '.pub-cache'),
                              'hosted', 'pub.dev', 'flutter_inappwebview_macos-*',
                              'macos', 'flutter_inappwebview_macos', 'Sources',
                              'flutter_inappwebview_macos', 'WebAuthenticationSession',
                              'WebAuthenticationSession.swift')].sort.last
  if target_file && File.writable?(target_file)
    body = File.read(target_file)
    helper = "@available(macOS 10.15, *)\n" \
             "private class WebAuthenticationPresentationContextProviding: NSObject, ASWebAuthenticationPresentationContextProviding {\n" \
             "    public func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {\n" \
             "        return NSApplication.shared.windows.first { $0.isKeyWindow } ?? ASPresentationAnchor()\n" \
             "    }\n" \
             "}\n\n"
    old_method = "    @available(macOS 10.15, *)\n" \
                 "    public func presentationAnchor(for session: ASWebAuthenticationSession) -> ASPresentationAnchor {\n" \
                 "        return NSApplication.shared.windows.first { $0.isKeyWindow } ?? ASPresentationAnchor()\n" \
                 "    }\n"
    patched = body
      .gsub("public class WebAuthenticationSession: NSObject, ASWebAuthenticationPresentationContextProviding, Disposable {",
            helper + "public class WebAuthenticationSession: NSObject, Disposable {")
      .gsub("    private var _canStart = true",
            "    private var _canStart = true\n" \
            "    // keep reference\n" \
            "    private var _presentationContextProvider: Any?")
      .gsub("            session.presentationContextProvider = self",
            "            let provider = WebAuthenticationPresentationContextProviding()\n" \
            "            self._presentationContextProvider = provider\n" \
            "            session.presentationContextProvider = provider")
      .gsub(old_method, "")
    if patched != body
      File.write(target_file, patched)
      Pod::UI.puts "Patched #{target_file}"
    end
  end
end
